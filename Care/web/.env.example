# ------------------------------------------------------------
# Next.js app
# ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/colaris_db
MIGRATION_DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ------------------------------------------------------------
# Optional shared store for rate limiting / token blacklist
# ------------------------------------------------------------
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------
# Cloudinary resident face sheet photo uploads
# ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------
# JWT Keys (RS256)
# ------------------------------------------------------------
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_PRIVATE_KEY_PATH=./secrets/jwt.private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt.public.pem
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=8h

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECRET=change-me-in-production
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# Login rate limit default is 25 failed attempts per 60s per IP; successful logins reset the counter.
AUTH_RATE_LIMIT_MAX=25

# ------------------------------------------------------------
# Demo mode
# ------------------------------------------------------------
# Leave UNSET for every real deployment. When set to "true" (and only outside a
# production build), useApiQuery is allowed to fall back to bundled sample
# fixtures if a non-auth request fails, so the UI can be demoed without a live
# API. Unset = lists always show real loading / error / empty states instead.
# NEXT_PUBLIC_COLARIS_DEMO=true

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL=info

# ------------------------------------------------------------
# PHI Encryption Configuration
# ------------------------------------------------------------
ENCRYPTION_KEY_STRATEGY=env-var
KMS_REGION=us-east-1
KMS_RESIDENT_ENCRYPTION_KEY_ID=
VAULT_ADDR=
VAULT_TOKEN=
ENCRYPTION_KEY_FILE_PATH=
TENANT_ENCRYPTION_KEY=
DEV_TENANT_ENCRYPTION_KEY=dev-only-32-char-key-change-me!!
ENCRYPTION_KEY_CACHE_TTL_MS=3600000
VALIDATE_ENCRYPTION_KEYS=false

# Form upload parsing — pick ONE model source.
# RECOMMENDED (free + good, reads handwriting): a Google AI Studio key. Gemini
# 2.5 Flash is multimodal with a generous free tier. Get one at
# https://aistudio.google.com/apikey — when set, all parsers use it (free) and
# ignore the gateway.
GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_PARSE_MODEL=gemini-2.5-flash

# ALTERNATIVE: Vercel AI Gateway (metered/paid, or free-credits). Used only when
# no Google key is set. Needs this key or Vercel OIDC.
AI_GATEWAY_API_KEY=
# Gateway model slug for extraction (default: anthropic/claude-haiku-4.5)
PROGRESS_NOTE_PARSE_MODEL=
# Model for admission-form upload parsing (default: anthropic/claude-sonnet-4.5)
ADMISSION_PARSE_MODEL=
